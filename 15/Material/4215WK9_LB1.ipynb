    "             and isinstance(l.kernel_initializer, HeNormal))\n",
    "\n",
    "n_l2    = sum(1 for l in model.layers\n",
    "              if isinstance(l, Dense)\n",
    "              and l.kernel_regularizer is not None)\n",
    "\n",
    "n_bn    = sum(1 for l in model.layers if isinstance(l, BatchNormalization))\n",
    "\n",
    "n_dr    = sum(1 for l in model.layers if isinstance(l, Dropout))\n",
    "\n",
    "print(f\"Dense layers    : {n_dense}\")\n",
    "print(f\"HeNormal Kernels: {n_he} <- all hidden layers + softmax head\")\n",
    "print(f\"L2-Regularised  : {n_l2} <- all hidden layers + softmax head\")\n",
    "print(f\"BatchNorm layers: {n_bn} <- one per hidden block\")\n",
    "print(f\"Dropout layers  : {n_dr} <- one per hidden block\")\n",
    "\n",
    "# BN/Dropout deliberately sit only on 3 hidden blocks: \n",
    "#    Normalising or Droping the 10-way probability vector befor the softmax would distort the clss score\n",
    "\n",
    "assert n_he == n_l2 == n_dense, \"every dense layer must carry He init + L2\"\n",
    "assert n_bn == n_dr == 3, \"expected one batchNorm + One Dropout per hidden block\"\n",
    "print(\"\\nAll 4 stage-3 requirements satisfied\")"
   ]
