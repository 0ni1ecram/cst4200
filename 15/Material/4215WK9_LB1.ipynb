   "source": [
    "REPORTS = {}\n",
    "\n",
    "def evaluate(name, x, y_oh, y_hrd):\n",
    "    loss, acc = model.evaluate(x, y_oh, verbose=0)\n",
    "    probs = model.predict(x, verbose=0)\n",
    "    pred = np.argmax(probs, axis=1)\n",
    "    # Keras Keeps regularisation losses separate\n",
    "    #       Sum them for penatly magnitude.\n",
    "    penalty = float(tf.add_n(model.losses)) if model.losses else 0.0\n",
    "    print(f\"\\n====== {name} ========\")\n",
    "    print(f\"loss {loss:.4f} (cross-entropy) {loss - penalty:.4f} + L2 penalty {penalty:.4f})\")\n",
    "    print(f\"accuracy {acc * 100:.2f}%\")\n",
    "    print(classification_report(y_hrd, pred, digits=4))\n",
    "    REPORTS[name] = dict(loss=loss, acc=acc, penalty=penalty, pred=pred)\n",
    "    return acc, pred\n",
    "\n",
    "# TRaining-set Performance: on the 50k we actually fitted a 10k value slice\n",
    "tr_acc =evaluate(\"TRAIN (fit split, 50k)\", x_fit, y_fit, yTrn[:-10000])\n",
    "va_acc = evaluate(\"VALIDATION (10k)\", x_val, y_val, yTrn[-10000:])\n",
    "te_acc = evaluate(\"TEST (10k, never used for tuning)\", x_tests_N, y_tests_Oh, yTst)"
   ]
