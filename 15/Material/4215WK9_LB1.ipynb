     ]
    }
   ],
   "source": [
    "sd = 63 # seed\n",
    "keras.utils.set_random_seed(sd)\n",
    "NUM_CLASSES = 10\n",
    "\n",
    "L2_SCALE = 1e-4       # Strength of the L2 penalty (light:1e-5...heavy:1.e-3)\n",
    "DROPOUT_RATE =  0.25  # fraction of units droped during training\n",
    "EPOCH_MAIN = 10       # epoch for the regularisation model\n",
    "\n",
    "# Print\n",
    "print(f\"TensorFlow Version: {tf.__version__} | Keras Version: {keras.__version__}\")"
   ]
  },
