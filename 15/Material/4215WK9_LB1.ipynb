   ],
   "source": [
    "def build_model(l2_scale = L2_SCALE, dropout=DROPOUT_RATE, seed=sd):\n",
    "    \"\"\" Dense ANN with all four ingredients on every hidden block \"\"\"\n",
    "    hidden = dict(activation=\"relu\",                       # ReLU -> needs He\n",
    "                  kernel_initializer=HeNormal(seed=sd),    # He Normal\n",
    "                  kernel_regularizer=L2(l2_scale)          # L2\n",
    "                 )\n",
    "    return keras.Sequential([\n",
    "        Input(shape=(28, 28, 1)),\n",
    "        Flatten(name=\"flatten_in\"),\n",
    "\n",
    "        Dense(512, name=\"dense_1\", **hidden),\n",
    "        BatchNormalization(name=\"bn_1\"),                   # BatchNorm\n",
    "        Dropout(dropout,  name=\"drop_1\"),                  # Dropout\n",
    "\n",
    "        Dense(512, name=\"dense_2\", **hidden),\n",
    "        BatchNormalization(name=\"bn_2\"),\n",
    "        Dropout(dropout, name=\"drop_2\"),\n",
    "\n",
    "        Dense(256, name=\"dense_3\", **hidden),\n",
    "        BatchNormalization(name=\"bn_3\"),\n",
    "        Dropout(dropout, name=\"drop_3\"),\n",
    "\n",
    "        Dense(NUM_CLASSES, activation=\"softmax\", name=\"output\",   # 10-way Probs\n",
    "              kernel_initializer=HeNormal(seed=sd),\n",
    "              kernel_regularizer=L2(l2_scale))\n",
    "    ])\n",
    "\n",
    "model = build_model()\n",
    "model.compile(optimizer=\"adam\",                                  # adaptive LR, pairs well with BN\n",
    "              loss=\"categorical_crossentropy\",                   # needs the one-hot targets\n",
    "              metrics=[\"accuracy\"])\n",
    "model.summary()"
   ]
  },
