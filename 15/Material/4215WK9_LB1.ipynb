   "id": "2cbc0ca0-78bd-4e5d-aa9e-65e50fc635ad",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "initialiser       RMS pre-ReLU RMS post-ReLU     kept\n",
      "-------------------------------------------------------\n",
      "glorot_uniform          1.0009         0.7079   70.7%\n",
      "he_normal               1.4132         0.9995   70.7%\n",
      "\n",
      "input unit-variance=1.000\n",
      "glorot_uniform leaves 0.7079 per layer -> over 3 hidden layers: 0.3547\n",
      "he_normal      leaves 0.9995 per layer -> over 3 hidden layers: 0.9984\n",
      "\n",
      "He's extra factor sqrt(2/FAN_in) vs Xavier's 2/(FAN_in + FAN_out): \n",
      "  is the exactly the compensation for half of the activations ReLU clips to zero:  \n",
      "  it holds the post-ReLU second moment at ~1.0, so signal neither decays nor explodes with depth.\n"
     ]
    }
   ],
   "source": [
    "\n",
    "rng = np.random.default_rng(sd)\n",
    "FAN_in = 512\n",
    "h_in = rng.normal(0.0, 1.0, size=(20_000, FAN_in))       # Unit Variance Activations in\n",
    "\n",
    "def stats(init):\n",
    "    w = np.asarray(init((FAN_in, FAN_in)), dtype=\"float64\")\n",
    "    z = h_in @ w\n",
    "    rms = lambda v: float(np.sqrt(np.mean(v * v)))\n",
    "    return rms(z), rms(np.maximum(z, 0.0))\n",
    "\n",
    "glorot = lambda shp: GlorotUniform(seed=sd)(shp)\n",
    "he     = lambda shp: HeNormal(seed=sd)(shp)\n",
    "\n",
    "print(f\"{'initialiser':16s}{'RMS pre-ReLU':>14s}{'RMS post-ReLU':>14s} {'kept':>8s}\")\n",
    "print(\"-\"* 55)\n",
    "res = {}\n",
    "for name, ini in [(\"glorot_uniform\", glorot), (\"he_normal\", he)]:\n",
    "    pre, post = stats(ini)\n",
    "    res[name] = (pre, post)\n",
    "    print(f\"{name:16s} {pre:13.4f} {post:14.4f} {post/pre:7.1%}\")\n",
    "\n",
    "g, h = res[\"glorot_uniform\"][1], res[\"he_normal\"][1]\n",
    "print(f\"\\ninput unit-variance=1.000\")\n",
    "print(f\"glorot_uniform leaves {g:.4f} per layer -> over 3 hidden layers: {g**3:.4f}\")\n",
    "print(f\"he_normal      leaves {h:.4f} per layer -> over 3 hidden layers: {h**3:.4f}\")\n",
    "print(f\"\\nHe's extra factor sqrt(2/FAN_in) vs Xavier's 2/(FAN_in + FAN_out): \")\n",
    "print(f\"  is the exactly the compensation for half of the activations ReLU clips to zero:  \")\n",
    "print(f\"  it holds the post-ReLU second moment at ~1.0, so signal neither decays nor explodes with depth.\")"
   ]
  },
